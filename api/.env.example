PORT=4400
# Supabase local (supabase start); never a cloud project
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Where imported/exported media and loaded fonts are kept
# ASSETS_DIR=.data/assets
# FONTS_DIR=.data/fonts
# ffmpeg/ffprobe, if they are not on PATH
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# Optional image AI for generate_image (off when IMAGE_AI_PROVIDER is empty).
# Providers: openai (transparent PNGs), gemini, replicate, fal. Set only that provider's key.
# IMAGE_AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# REPLICATE_API_TOKEN=r8_...
# FAL_KEY=...
# IMAGE_AI_MODEL=      (optional: another model of the same provider)
# IMAGE_AI_BASE_URL=   (optional: a proxy or compatible server instead of the provider's own address)
# Optional local speech-to-text for transcribe_video and auto_captions (off when WHISPER_MODEL_PATH is empty).
# Install whisper.cpp (brew install whisper-cpp) and download a model, e.g. ggml-small.bin or ggml-large-v3-turbo.bin
# from https://huggingface.co/ggerganov/whisper.cpp
# WHISPER_MODEL_PATH=~/models/ggml-small.bin
# WHISPER_CLI_PATH=whisper-cli   (if it is not on PATH)
# WHISPER_LANGUAGE=auto          (or pt, en, ... for better accuracy)
