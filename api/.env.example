PORT=4400
UI_URL=http://localhost:5400
# Supabase local (supabase start); never a cloud project
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Local Supabase Auth (printed by `supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# Encrypts account secrets; by default a key is created in .data/secret.key
# RELAY_SECRET_KEY=
# SECRET_KEY_FILE=.data/secret.key
